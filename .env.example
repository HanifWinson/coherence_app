# Copy to .env for local dev. Everything here has a working default except the secret.

# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses. In dev that's the Vite server, which proxies /api.
BETTER_AUTH_URL=http://localhost:5173

# Unset = embedded PGlite in .data/pglite (no install needed).
# Production: Postgres in an Australian region (PRD §2), e.g.
# DATABASE_URL=postgres://user:pass@host:5432/coherence
DATABASE_URL=

PORT=8787
