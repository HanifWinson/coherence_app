# Copy to .env for local dev. Everything here has a working default except the secret.
# On Vercel, set these under Project -> Settings -> Environment Variables instead.

# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses. Dev: the Vite server (it proxies /api).
# Vercel: your production URL, e.g. https://coherence-app.vercel.app
BETTER_AUTH_URL=http://localhost:5173

# Unset = embedded PGlite in .data/pglite (no install needed).
# Production: Postgres in an Australian region (PRD §2). On Vercel, the Neon
# integration sets this - use the POOLED connection string.
DATABASE_URL=

# Public practice sign-up. Defaults: open in dev, CLOSED in production.
# ALLOW_PRACTICE_REGISTRATION=true

PORT=8787
